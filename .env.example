# PMU OS - biến môi trường mẫu (KHÔNG chứa secret thật)
# Để trống DATABASE_URL khi chạy máy cá nhân: hệ thống dùng PGlite lưu ở ./.data/pglite
DATABASE_URL=
# Tài khoản chủ doanh nghiệp (môi trường thật). Lần đăng nhập đầu tiên với đúng cặp này sẽ tạo doanh nghiệp thật rỗng.
OWNER_EMAIL=
OWNER_PASSWORD=
# Bí mật ký phiên (tùy chọn, chuỗi ngẫu nhiên dài)
SESSION_SECRET=
